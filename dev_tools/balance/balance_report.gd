extends Node

const OUT_DIR : String = "res://extras/balance_reports/"
const RUNS : int = 40
const BUDGETS : Array[int] = [0, 150, 400, 900, 2500]
const FLOORS : Array[int] = [0, 1, 2, 3]
const OBJECTIVES : Array[int] = [
	RunData.Objective.DESTROY_BASE, RunData.Objective.DEFEND, RunData.Objective.ESCORT,
	RunData.Objective.HUNT_SUBMARINE, RunData.Objective.SHOOT_DOWN_BOMBER, RunData.Objective.DEFEAT_BOSS,
]

var _lines : PackedStringArray = []

func _ready() -> void:
	var args : PackedStringArray = OS.get_cmdline_user_args()
	var quick : bool = "quick" in args
	_line("# Balance report")
	_line("")
	_line("Generated by `dev_tools/balance`. Abstract simulator: calibrate `speed_scale` and `hit_rate` against real battles before trusting absolute numbers; compare relative values.")
	_line("")
	_unit_table()
	_gun_upgrade_table()
	_spawn_table()
	_sweep(2 if quick else RUNS)
	_policy_table(2 if quick else RUNS)
	_cap_table(2 if quick else RUNS)
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT_DIR))
	var path : String = OUT_DIR + "balance_latest.md"
	var file : FileAccess = FileAccess.open(path, FileAccess.WRITE)
	file.store_string("\n".join(_lines))
	file.close()
	print("\n".join(_lines))
	get_tree().quit()

func _line(text : String) -> void:
	_lines.append(text)

func _units() -> Array[BalanceUnit]:
	var result : Array[BalanceUnit] = []
	for item : Variant in Global.CATALOG.units:
		result.append(BalanceSim.profile_of(item as BoatStats))
	return result

func _unit_table() -> void:
	_line("## Units (static, no upgrades)")
	_line("")
	_line("| unit | class | price | unlock | build s | hp | speed | radar | range | dps surf | dps air | dps sub | value | hp*dps/price |")
	_line("|---|---|---|---|---|---|---|---|---|---|---|---|---|---|")
	var values : Array[float] = []
	for unit : BalanceUnit in _units():
		values.append(BalanceSim.static_value(unit))
	values.sort()
	var median : float = values[values.size() / 2]
	for unit : BalanceUnit in _units():
		var value : float = BalanceSim.static_value(unit)
		var flag : String = ""
		if (value > median * 1.6):
			flag = " HIGH"
		elif (value < median * 0.5):
			flag = " LOW"
		_line("| %s | %d | %d | %d | %.0f | %.0f | %.0f | %.0f | %.0f | %.2f | %.2f | %.2f | %.1f%s | %.2f |" % [
			unit.id, unit.unit_class, unit.price, unit.stats.unlock_cost, unit.build_time, unit.health, unit.speed,
			unit.radar, unit.max_range(), unit.dps("surface"), unit.dps("air"), unit.dps("sub"), value, flag, value / median])
	_line("")
	_line("Median value %.1f. HIGH/LOW = more than 1.6x or less than 0.5x the median." % median)
	_line("")

func _gun_upgrade_table() -> void:
	_line("## Gun damage research (multiplier, same for every gun)")
	_line("")
	_line("Max research: shop heavy shells x%.2f * gunpowder mix x%.2f * heavy shells II x%.2f = x%.2f on every bullet (was flat +6: mini x7, cruiser x2.7)." % [
		pow(1.15, 3.0), pow(1.15, 2.0), 1.15, pow(1.15, 6.0)])
	_line("")

func _spawn_table() -> void:
	_line("## Enemy production ceiling (no kills, director neutral)")
	_line("")
	_line("Units per minute each enemy dock can start, limited by build time. Wave 0 and wave 3.")
	_line("")
	_line("| floor | dock | interval w0 | interval w3 | build s (avg pool) | max/min w0 | max/min w3 |")
	_line("|---|---|---|---|---|---|---|")
	for floor_index : int in FLOORS:
		var entry : Dictionary = {"col": floor_index, "objective": RunData.Objective.DESTROY_BASE, "type": RunData.NodeType.BATTLE}
		var tier : BaseTier = RunBattleConfig.tier_for(entry)
		var pool : Array[BoatStats] = RunBattleConfig.pool_for(entry)
		for dock_type : int in [BaseDock.Type.NAVAL, BaseDock.Type.AIR, BaseDock.Type.SUB]:
			var times : Array[float] = []
			for stats : BoatStats in pool:
				if (Base.dock_type_of(stats) == dock_type):
					times.append(float(stats.produce_cd))
			if (times.is_empty()):
				continue
			var avg : float = 0.0
			for value : float in times:
				avg += value
			avg /= times.size()
			var mult : float = 1.0 if dock_type == BaseDock.Type.NAVAL else 1.5
			var base_interval : float = RunData.ENEMY_SPAWN_INTERVAL[floor_index]
			var i0 : float = maxf(2.5, base_interval) * tier.production_interval_mult * mult
			var i3 : float = maxf(2.5, base_interval * pow(RunData.WAVE_RAMP_INTERVAL, 3)) * tier.production_interval_mult * mult
			_line("| %d | %d | %.1f | %.1f | %.1f | %.1f | %.1f |" % [floor_index, dock_type, i0, i3, avg,
					60.0 / maxf(i0, avg), 60.0 / maxf(i3, avg)])
	_line("")

func _scenario(objective : int, floor_index : int, budget : int, policy : int, seed_value : int) -> BalanceScenario:
	var scn : BalanceScenario = BalanceScenario.new()
	scn.objective = objective
	scn.floor_index = floor_index
	scn.gear_budget = budget
	scn.coin_budget = budget / 250
	scn.policy = policy as BalanceScenario.Policy
	scn.seed_value = seed_value
	scn.distance_t = float(seed_value % 5) / 4.0
	scn.progress = BalanceProgress.build(Global.CATALOG, budget, scn.coin_budget)
	return scn

func _batch(objective : int, floor_index : int, budget : int, policy : int, runs : int, cap : int = 0) -> Dictionary:
	var wins : int = 0
	var time_sum : float = 0.0
	var peak_sum : float = 0.0
	var peak_max : int = 0
	var contested : float = 0.0
	var ally_hp : float = 0.0
	var reasons : Dictionary = {}
	for index : int in range(runs):
		var scn : BalanceScenario = _scenario(objective, floor_index, budget, policy, 1000 + index)
		scn.spawn_cap = cap
		scn.extra_boss = false
		var result : Dictionary = BalanceSim.new().run(scn)
		if (bool(result["won"])):
			wins += 1
		time_sum += float(result["time"])
		peak_sum += float(result["peak_enemies"])
		peak_max = maxi(peak_max, int(result["peak_enemies"]))
		contested += float(result["contested"])
		ally_hp += float(result["ally_hp"])
		var reason : String = str(result["reason"])
		reasons[reason] = int(reasons.get(reason, 0)) + 1
	return {"win": float(wins) / runs, "time": time_sum / runs, "peak": peak_sum / runs, "peak_max": peak_max,
			"contested": contested / runs, "ally_hp": ally_hp / runs, "reasons": reasons}

func _sweep(runs : int) -> void:
	_line("## Win rate by objective, floor and progression (policy COUNTER)")
	_line("")
	var header : String = "| objective | floor |"
	var divider : String = "|---|---|"
	for budget : int in BUDGETS:
		header += " %d gears |" % budget
		divider += "---|"
	_line(header)
	_line(divider)
	for objective : int in OBJECTIVES:
		for floor_index : int in FLOORS:
			var row : String = "| %s | %d |" % [RunData.OBJECTIVES[objective]["icon"], floor_index]
			for budget : int in BUDGETS:
				var stats : Dictionary = _batch(objective, floor_index, budget, BalanceScenario.Policy.COUNTER, runs)
				row += " %d%% (pk %.0f/%d) |" % [int(float(stats["win"]) * 100.0), float(stats["peak"]), int(stats["peak_max"])]
			_line(row)
	_line("")
	_line("`pk a/b` = average / worst peak of enemies alive at once.")
	_line("")

func _policy_table(runs : int) -> void:
	_line("## Skill gap: policy at 400 gears, floor 1")
	_line("")
	_line("| objective | random | cheapest | counter |")
	_line("|---|---|---|---|")
	for objective : int in OBJECTIVES:
		var row : String = "| %s |" % RunData.OBJECTIVES[objective]["icon"]
		for policy : int in [BalanceScenario.Policy.RANDOM, BalanceScenario.Policy.CHEAPEST, BalanceScenario.Policy.COUNTER]:
			var stats : Dictionary = _batch(objective, 1, 400, policy, runs)
			row += " %d%% |" % int(float(stats["win"]) * 100.0)
		_line(row)
	_line("")

func _cap_table(runs : int) -> void:
	_line("## Experiment: cap on live enemies (floor 2, 400 gears, COUNTER)")
	_line("")
	_line("| objective | no cap win | no cap peak | cap 8 win | cap 8 peak | cap 12 win | cap 12 peak |")
	_line("|---|---|---|---|---|---|---|")
	for objective : int in [RunData.Objective.DEFEND, RunData.Objective.HUNT_SUBMARINE, RunData.Objective.SHOOT_DOWN_BOMBER, RunData.Objective.DEFEAT_BOSS]:
		var row : String = "| %s |" % RunData.OBJECTIVES[objective]["icon"]
		for cap : int in [0, 8, 12]:
			var stats : Dictionary = _batch(objective, 2, 400, BalanceScenario.Policy.COUNTER, runs, cap)
			row += " %d%% | %.1f (max %d) |" % [int(float(stats["win"]) * 100.0), float(stats["peak"]), int(stats["peak_max"])]
		_line(row)
	_line("")

extends Node

const OUT_DIR : String = "res://extras/balance_reports/"
var _lines : PackedStringArray = []

func _ready() -> void:
	_line("# Balance report")
	_line("")
	_line("Generated by `dev_tools/balance`. Static values from unit and gun data, not from battles.")
	_line("")
	_unit_table()
	_gun_upgrade_table()
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT_DIR))
	var path : String = OUT_DIR + "balance_latest.md"
	var file : FileAccess = FileAccess.open(path, FileAccess.WRITE)
	file.store_string("\n".join(_lines))
	file.close()
	print("\n".join(_lines))
	get_tree().quit()

func _line(text : String) -> void:
	_lines.append(text)

func _units() -> Array[BalanceUnit]:
	var result : Array[BalanceUnit] = []
	for item : Variant in Global.CATALOG.units:
		result.append(BalanceFleet.profile_of(item as BoatStats))
	return result

func _unit_table() -> void:
	_line("## Units (static, no upgrades)")
	_line("")
	_line("| unit | class | price | unlock | build s | hp | speed | radar | range | dps surf | dps air | dps sub | value | hp*dps/price |")
	_line("|---|---|---|---|---|---|---|---|---|---|---|---|---|---|")
	var values : Array[float] = []
	for unit : BalanceUnit in _units():
		values.append(BalanceFleet.static_value(unit))
	values.sort()
	var median : float = values[values.size() / 2]
	for unit : BalanceUnit in _units():
		var value : float = BalanceFleet.static_value(unit)
		var flag : String = ""
		if (value > median * 1.6):
			flag = " HIGH"
		elif (value < median * 0.5):
			flag = " LOW"
		_line("| %s | %d | %d | %d | %.0f | %.0f | %.0f | %.0f | %.0f | %.2f | %.2f | %.2f | %.1f%s | %.2f |" % [
			unit.id, unit.unit_class, unit.price, unit.stats.unlock_cost, unit.build_time, unit.health, unit.speed,
			unit.radar, unit.max_range(), unit.dps("surface"), unit.dps("air"), unit.dps("sub"), value, flag, value / median])
	_line("")
	_line("Median value %.1f. HIGH/LOW = more than 1.6x or less than 0.5x the median." % median)
	_line("")

func _gun_upgrade_table() -> void:
	_line("## Gun damage research (multiplier, same for every gun)")
	_line("")
	_line("Max research: shop heavy shells x%.2f * gunpowder mix x%.2f * heavy shells II x%.2f = x%.2f on every bullet (was flat +6: mini x7, cruiser x2.7)." % [
		pow(1.15, 3.0), pow(1.15, 2.0), 1.15, pow(1.15, 6.0)])
	_line("")
